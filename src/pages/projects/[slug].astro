---
/**
 * Case Study Detail Page
 *
 * Dynamic route that displays a project case study. The narrative itself
 * (Overview → Problem → Constraints → Approach → Key Decisions → Result &
 * Impact → Learnings → the story behind it) is authored as markdown in the
 * entry's MDX body and rendered wholesale by <Content />; this page only
 * supplies the header panel around it.
 *
 * Route: /projects/[slug]
 *
 * @page
 */

import Layout from '@layouts/Layout.astro';
import SEO from '@components/SEO.astro';
import StructuredData from '@components/StructuredData.astro';
import ScrollToTop from '@components/ScrollToTop.astro';
import TagList from '@components/TagList.astro';
import Button from '@components/Button.astro';
import Media from '@components/Media.astro';
import EditableStyle from '@components/EditableStyle.astro';
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import { projectGrid } from '@/grid.config';

/**
 * Generates static paths for all project entries
 *
 * Queries the projects content collection and creates a route for each entry
 * using the entry ID as the slug parameter. The entry rides along as a prop, so
 * the page never has to look it back up.
 *
 * @returns Array of path objects with params and props
 */
export const getStaticPaths: GetStaticPaths = async () => {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
};

type ProjectEntry = Awaited<ReturnType<typeof getCollection<'projects'>>>[number];

interface Props {
  /** The project entry from the content collection */
  project: ProjectEntry;
}

const { project } = Astro.props;

// `headings` is slugged by Astro's markdown pipeline and matches the `id`s it
// emits, so it drives the table of contents with no extra work.
const { Content, headings } = await render(project);

const { title, year, outcomeSummary, techStack, image, imageAlt } = project.data;
---

{/* The panel is derived from the entry and overridden by its frontmatter; both
    live in grid.config.ts beside the listing pages' panels.
    TOC capped at 2: the body's `###`s are one-sentence key-decision titles. */}
<Layout
  headings={headings}
  tocMaxDepth={2}
  grid={projectGrid(project)}
>
  <Fragment slot="head">
    <SEO
      title={`${title} - Case Study`}
      description={outcomeSummary}
      type="article"
    />
    <StructuredData
      type="Project"
      data={{
        title,
        outcomeSummary,
        techStack,
        year,
      }}
    />
  </Fragment>

  {/* A case study can carry its own `image`; without one the panel shows what
      the /projects listing shows, so the section reads as one place. */}
  <Fragment slot="media">
    {image ? <Media src={image} alt={imageAlt ?? title} /> : <EditableStyle />}
  </Fragment>

  <Fragment slot="main">
    <TagList items={techStack} />

    <Content />

    <Button href="/projects" back>
      All projects
    </Button>

    <ScrollToTop />
  </Fragment>
</Layout>
