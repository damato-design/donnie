---
/**
 * Home Page
 *
 * The site's entry point. The dashboard panel carries the identity (name,
 * role, the two primary paths into the site) with the portrait as its media,
 * and <main> holds the topics of interest plus the closing CTA.
 *
 * Route: /
 *
 * @page
 */

import Layout from '@layouts/Layout.astro';
import SEO from '@components/SEO.astro';
import StructuredData from '@components/StructuredData.astro';
import Media from '@components/Media.astro';
import Button from '@components/Button.astro';
import ButtonGroup from '@components/ButtonGroup.astro';
import type { MarkdownHeading } from 'astro';
import { siteConfig } from '@/config';
import portrait from '@assets/stageworthy.png';

/**
 * Table of contents for `<main>`. Authored in Astro rather than markdown, so
 * this array is the single source for the section headings, their `id`s, and
 * the TOC links.
 */
const headings: MarkdownHeading[] = [
  { depth: 2, slug: 'problems-i-enjoy-solving', text: 'Problems I Enjoy Solving' },
  { depth: 2, slug: 'lets-work-together', text: "Let's Work Together" },
];
const [thinking, cta] = headings;

/** The panel's intro paragraph, built from config so the identity stays in one place. */
const anecdote = 'UX Architect improving design systems and AI model behavior.';
---

<Layout
  headings={headings}
  grid={{
    title: siteConfig.author.name,
    headline: 'Experience Architect',
    description: siteConfig.description,
    cta: [
      { label: 'Explore my work', href: '/projects' },
      { label: 'Follow my thinking', href: '/decisions' },
    ],
    metric: { value: 25, label: 'years' },
    anecdote,
  }}
>
  <Fragment slot="head">
    <SEO
      title={`${siteConfig.author.name} - ${siteConfig.author.title}`}
      description={siteConfig.description}
      type="website"
      noSuffix
    />
    <StructuredData type="WebSite" />
    <StructuredData type="Person" />
  </Fragment>

  <Media slot="media" src={portrait} alt={`Portrait of ${siteConfig.author.name}`} />

  <Fragment slot="main">
    <section>
      <p>Hey, I'm Donnie D'Amato, a user experience architect who finds creativity within constraints, with a background spanning design, front-end engineering, and higher education. I've worked across the design systems practice for many years, from token architecture and governance to the strategic frameworks that bring coherence across an organization. Now I'm bringing that same discipline to a new frontier: shaping how AI behaves with the rigor we expect from a best in class interface.</p>
    </section>

    <section class="thinking">
      <h2 id={thinking.slug}>{thinking.text}</h2>
      <ul>
        <li><strong>Translating an organization's intent into reusable guidelines</strong>, the kind that once shaped components and tokens, now shaping how AI behaves: its voice, tone, trust, and safety</li>
        <li><strong>Pioneering systems where including every user advances the business</strong>; serving more people and growing it become the same winning move</li>
        <li><strong>Teaching the next generation</strong> through writing, speaking, and the classroom; sharing the thinking openly so the whole practice matures faster</li>
      </ul>
    </section>

    <section class="cta">
      <h2 id={cta.slug}>{cta.text}</h2>
      <p>
        Looking for user experience leadership, design systems and token architecture, guidance on designing how AI behaves, or someone who documents their thinking and shares it openly? Let's talk.
      </p>
      <ButtonGroup>
        <Button href="/projects" variant="primary">View My Work</Button>
        <Button href={siteConfig.scheduling} variant="secondary" external>Get in Touch</Button>
      </ButtonGroup>
    </section>
  </Fragment>
</Layout>
