---
/**
 * 404 Not Found Page
 *
 * Custom error page displayed when a requested page doesn't exist. It uses the
 * same dashboard shell as every other page, so a reader who lands here still
 * has the full navigation, the connect bar, and a way onward.
 *
 * Route: /404 (automatically served for non-existent pages)
 *
 * @page
 */

import Layout from '@layouts/Layout.astro';
import SEO from '@components/SEO.astro';
import { siteConfig } from '@/config';
---

<Layout
  grid={{
    title: '404',
    headline: 'Page Not Found',
    description: "The page you're looking for doesn't exist or has been moved.",
    cta: [{ label: 'Back to home', href: '/' }],
  }}
>
  <Fragment slot="head">
    <SEO title="404 - Page Not Found" noSuffix />
    <meta name="robots" content="noindex, nofollow" />
  </Fragment>

  <Fragment slot="main">
    <h2>Let's get you back on track</h2>
    <ul>
      {siteConfig.nav.map((item) => (
        <li><a href={item.href}>{item.label}</a></li>
      ))}
    </ul>
  </Fragment>
</Layout>
