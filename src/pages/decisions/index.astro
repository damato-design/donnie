---
/**
 * Decisions Index Page
 * 
 * Lists all decision log entries. Provides a transparent view of architectural and
 * technical decisions made throughout the career, with each entry linking to its
 * detailed decision record.
 *
 * Features:
 * - Queries all decisions from content collection
 * - Displays decision count statistics
 * - Uses the shared Card component for consistent presentation
 * - SEO optimization
 * - Empty state handling
 * 
 * Route: /decisions
 * 
 * @page
 */

import Layout from '@layouts/Layout.astro';
import SEO from '@components/SEO.astro';
import Card from '@components/Card.astro';
import CardList from '@components/CardList.astro';
import ButtonGroup from '@components/ButtonGroup.astro';
import Button from '@components/Button.astro';
import TagList from '@components/TagList.astro';
import Media from '@components/Media.astro';
import { getCollection } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import { pagesConfig } from '@/pages.config';
import { gridContent } from '@/grid.config';
import { siteConfig } from '@/config';
import uxdx from '@assets/uxdx.jpg'

/**
 * Queries all decisions from the content collection
 */
const allDecisions = await getCollection('decisions');

/**
 * Table of contents for `<main>`: one entry per decision record.
 *
 * `depth` describes the TOC's own structure, not the rendered element (the card
 * titles are `<h3>`s); these are the page's only sections, so they are top
 * level. The `slug` is the card's `id`, set from this same array below.
 */
const headings: MarkdownHeading[] = allDecisions.map((decision) => ({
  depth: 2,
  slug: `decision-${decision.id}`,
  text: decision.data.title,
}));
---

<Layout
  headings={headings}
  grid={gridContent.decisions}
>
  <SEO
    slot="head"
    title={pagesConfig.decisions.title}
    description={pagesConfig.decisions.description}
    type="website"
  />

  <Media slot="media" src={uxdx} alt={`${siteConfig.author.name} on stage`} />

  <CardList slot="main" compact>
    {allDecisions.map((decision) => (
      <li>
        <Card id={`decision-${decision.id}`}>
          <Fragment slot="title">{decision.data.title}</Fragment>
          <Fragment slot="description">{decision.data.context}</Fragment>

          <TagList slot="tags" items={decision.data.tags ?? []} />

          <ButtonGroup slot="cta">
            <Button href={`/decisions/${decision.id}`} variant="secondary" arrow>Read decision</Button>
          </ButtonGroup>
        </Card>
      </li>
    ))}
  </CardList>
</Layout>
