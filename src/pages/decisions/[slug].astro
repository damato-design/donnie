---
/**
 * Decision Detail Page
 *
 * Dynamic route that displays a decision record. The record itself (Decision →
 * Alternatives Considered → Reasoning → Why it mattered) is authored as
 * markdown in the entry's MDX body and rendered wholesale by <Content />; this
 * page only supplies the header panel around it.
 *
 * Route: /decisions/[slug]
 *
 * @page
 */

import Layout from '@layouts/Layout.astro';
import SEO from '@components/SEO.astro';
import ScrollToTop from '@components/ScrollToTop.astro';
import Button from '@components/Button.astro';
import TagList from '@components/TagList.astro';
import Media from '@components/Media.astro';
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import { decisionGrid } from '@/grid.config';
import { siteConfig } from '@/config';
import uxdx from '@assets/uxdx.jpg';

/**
 * Generates static paths for all decision entries
 *
 * Queries the decisions content collection and creates a route for each entry
 * using the entry ID as the slug parameter.
 *
 * @returns Array of path objects with params and props
 */
export const getStaticPaths: GetStaticPaths = async () => {
  const decisions = await getCollection('decisions');
  return decisions.map((decision) => ({
    params: { slug: decision.id },
    props: { decision },
  }));
};

type DecisionEntry = Awaited<ReturnType<typeof getCollection<'decisions'>>>[number];

interface Props {
  /** The decision entry from the content collection */
  decision: DecisionEntry;
}

const { decision } = Astro.props;

// `headings` is slugged by Astro's markdown pipeline and matches the `id`s it
// emits, so it drives the table of contents with no extra work.
const { Content, headings } = await render(decision);

const { title, context, tags, image, imageAlt } = decision.data;
---

{/* The panel is derived from the entry and overridden by its frontmatter; both
    live in grid.config.ts beside the listing pages' panels.
    TOC capped at 2: the body's `###`s are one-sentence alternative titles. */}
<Layout
  headings={headings}
  tocMaxDepth={2}
  grid={decisionGrid(decision)}
>
  <SEO
    slot="head"
    title={`${title} - Decision Record`}
    description={context}
    type="article"
  />

  {/* A record can carry its own `image`; without one the panel shows what the
      /decisions listing shows, so the section reads as one place. */}
  <Media
    slot="media"
    src={image ?? uxdx}
    alt={image ? (imageAlt ?? title) : `${siteConfig.author.name} on stage`}
  />

  <Fragment slot="main">
    <article class="decision-content">
      <TagList items={tags ?? []} />

      <Content />

      <Button href="/decisions" back>
        All decisions
      </Button>
    </article>

    <ScrollToTop />
  </Fragment>
</Layout>
