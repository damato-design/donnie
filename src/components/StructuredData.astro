---
/**
 * StructuredData
 *
 * Emits one JSON-LD block for search engines. Three shapes are used, and only
 * three: `WebSite` and `Person` on the home page, and `CreativeWork` for a
 * case study. (`Article` and `BreadcrumbList` branches were carried over from
 * the theme, never used, and are gone; add one back when a page actually needs
 * it, with typed props like the ones below.)
 *
 * Identity comes from `siteConfig` and the origin from `Astro.site`, so nothing
 * about the author is restated at a call site. `WebSite` and `Person` therefore
 * take no data at all; `Project` takes only the fields of the case study it
 * describes.
 *
 * @component
 *
 * @example
 * ```astro
 * <StructuredData type="WebSite" />
 * <StructuredData type="Person" />
 * <StructuredData type="Project" data={{ title, description, tags, year }} />
 * ```
 */
import { siteConfig } from '@/config';

/** The fields of a case study that end up in its `CreativeWork` block. */
interface ProjectData {
  /** Project title. */
  title: string;
  /** The outcome summary. */
  description: string;
  /** Technologies and approaches. */
  tags: string[];
  /** Year the project was completed. */
  year: number;
}

/**
 * A discriminated union rather than `Record<string, any>`: each shape declares
 * exactly what it needs, so a call site that forgets a field is a build error
 * and one that passes a stale field (this component used to read `data.problem`
 * and `data.impact`, dropped from the schema years ago) no longer type-checks.
 */
type Props =
  | { type: 'WebSite' | 'Person'; data?: never }
  | { type: 'Project'; data: ProjectData };

const props = Astro.props;

// Site root from Astro (`site:` in astro.config.mjs); always defined.
const siteURL = Astro.site!;
const context = 'https://schema.org';

/** The author, as the sub-object three of these blocks embed. */
const person = {
  '@type': 'Person',
  name: siteConfig.author.name,
  jobTitle: siteConfig.author.title,
  url: siteURL.href,
} as const;

function build(props: Props) {
  switch (props.type) {
    case 'WebSite':
      return {
        '@context': context,
        '@type': 'WebSite',
        name: siteConfig.title,
        description: siteConfig.description,
        url: siteURL.href,
        inLanguage: siteConfig.language,
        author: person,
        potentialAction: {
          '@type': 'SearchAction',
          target: {
            '@type': 'EntryPoint',
            // Built by concatenation, not `new URL`, so the {search_term_string}
            // placeholder is not percent-encoded. siteURL.href ends with '/'.
            urlTemplate: `${siteURL.href}writing?q={search_term_string}`,
          },
          'query-input': 'required name=search_term_string',
        },
      };

    case 'Person':
      return {
        '@context': context,
        ...person,
        description: siteConfig.author.bio,
        email: siteConfig.author.email,
        sameAs: siteConfig.social.map((profile) => profile.href).filter(Boolean),
      };

    case 'Project': {
      const { title, description, tags, year } = props.data;
      return {
        '@context': context,
        '@type': 'CreativeWork',
        name: title,
        description,
        author: { '@type': 'Person', name: siteConfig.author.name },
        dateCreated: `${year}-01-01`,
        keywords: tags.join(', '),
      };
    }
  }
}
---

<script is:inline type="application/ld+json" set:html={JSON.stringify(build(props), null, 2)} />
