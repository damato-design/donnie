---
/**
 * Label Component
 *
 * The single, shared primitive for all small labels: tags, type labels, and
 * project status.
 *
 * This is deliberately NOT a chip/button: no background, border, or rounded box.
 * Those make a non-interactive label look clickable ("Schrödinger's button").
 * It communicates purely through typographic hierarchy: color, weight, and case.
 * See https://blog.damato.design/posts/chip-away/
 *
 * Content is slotted, so a label can include a leading icon.
 *
 * @component
 *
 * @example
 * ```astro
 * <Label>react</Label>
 * ```
 */

interface Props {}
---

<span class="label">
  <slot />
</span>

<style>
  .label {
    display: inline-flex;
    align-items: center;
    gap: 1ch;
    font-size: 0.7em;
  }

  .label svg {
    flex-shrink: 0;
  }
</style>
