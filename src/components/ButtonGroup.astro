---
/**
 * ButtonGroup
 *
 * The layout wrapper for placing one or two action buttons together: a flex row
 * that gives its buttons a consistent gap and wraps on narrow viewports. Reach
 * for it wherever a `<Button>` (or two) is dropped into the page: section CTAs,
 * a card's body links, the 404 home link, etc. (the page-header panel's own
 * `cta` slot lays its links out itself). It owns only the
 * grouping/layout; the buttons themselves are composed as slotted children, so
 * each picks its own `variant`/`arrow`.
 *
 * @component
 * @slot default - The button(s) to lay out (one or two `<Button>`s).
 *
 * @example
 * ```astro
 * <ButtonGroup>
 *   <Button href="/projects" variant="primary">View My Work</Button>
 *   <Button href="/contact" variant="secondary">Get in Touch</Button>
 * </ButtonGroup>
 *
 * <Card href="/talks/x">
 *   ...
 *   <ButtonGroup>
 *     <Button href="https://slides.example" variant="secondary" external>Slides</Button>
 *   </ButtonGroup>
 * </Card>
 * ```
 */
---

<div class="button-group">
  <slot />
</div>

<style>
  .button-group {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--grid-gap);
    margin-block-start: var(--grid-padding);
  }
</style>
