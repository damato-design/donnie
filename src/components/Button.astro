---
/**
 * Button
 *
 * The action-button primitive, and the single home for button styling. Use it
 * for buttons and for links that *look* like buttons (CTAs, pagination
 * prev/next, etc.). Inline text links should stay plain `<a>` and not use this.
 *
 * Element rendered:
 * - `href` (and not disabled)  -> `<a>`
 * - `href` + `disabled`        -> `<span aria-disabled>` (non-navigable)
 * - no `href`                  -> `<button type=...>`
 *
 * Content is slotted, so an icon + label compose naturally (the button is a
 * flex row). There is **one visual treatment**, an outline control in
 * `--accent-color`: no `variant` and no `size` prop, so every button on the site
 * reads the same. Set `arrow` to append the standard trailing forward arrow or
 * `back` to prepend the leading back arrow (e.g. a detail page's "All projects");
 * fill the `icon` slot to prepend an `<Icon>` (e.g. a Slides/Video glyph).
 *
 * @component
 * @slot default - Button label / icon content.
 * @slot icon - Optional leading icon, rendered before the label.
 *
 * @example
 * ```astro
 * <Button href="/projects">View My Work</Button>
 * <Button href="https://cal.com/x" external>Book a call</Button>
 * <Button href="/projects" back>All projects</Button>
 * <Button href="https://slides.example" external>
 *   <Icon slot="icon" name="slides" />Slides
 * </Button>
 * <Button disabled aria-label="Previous page">…</Button>
 * ```
 */

import Icon from '@components/Icon.astro';
import type { HTMLAttributes } from 'astro/types';

/**
 * Any other valid attribute (aria-label, id, title, data-*, ...) is forwarded to
 * the rendered element. `<a>` is the base set; `href` and `type` are redeclared
 * below because this component gives them narrower meanings.
 */
interface Props extends Omit<HTMLAttributes<'a'>, 'href' | 'type'> {
  /** Destination. Provided -> renders a link; omitted -> renders a <button>. */
  href?: string;
  /** Open link in a new tab. */
  external?: boolean;
  /** Disabled state (non-interactive). */
  disabled?: boolean;
  /** Append the standard trailing forward arrow after the label. */
  arrow?: boolean;
  /** Prepend the standard leading back arrow before the label. */
  back?: boolean;
  /** Button type when rendered as <button>. */
  type?: 'button' | 'submit' | 'reset';
}

const {
  href,
  external = false,
  disabled = false,
  arrow = false,
  back = false,
  type = 'button',
  ...rest
} = Astro.props;

const Tag = !href ? 'button' : disabled ? 'span' : 'a';

const tagAttrs =
  Tag === 'a'
    ? { href, ...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {}) }
    : Tag === 'button'
      ? { type, disabled }
      : { 'aria-disabled': true };
---

<Tag
  class:list={[
    'btn',
    { 'btn--disabled': disabled },
  ]}
  {...tagAttrs}
  {...rest}
>
  <span>
    {back && <Icon name="arrow-left" />}
    <slot name="icon" />
    <slot />
    {arrow && <Icon name="arrow-right" />}
  </span>
</Tag>

<style>
  .btn {
    font-family: inherit;
    line-height: inherit;
    cursor: pointer;
    color: currentColor;
    background: transparent;
    display: inline-flex;
    border: 1px solid;
    color: var(--accent-color);
    text-decoration: none;
    font-weight: bolder;
    font-size: 0.8em;
    letter-spacing: 2px;

    span {
      display: inline-flex;
      padding: 8px 16px;
      align-items: center;
      justify-content: center;
      gap: 8px;
    }
  }

  .btn--disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }
</style>
