---
/**
 * Button
 *
 * The action-button primitive, and the single home for button styling. Use it
 * for buttons and for links that *look* like buttons (CTAs, pagination
 * prev/next, etc.). Inline text links should stay plain `<a>` and not use this.
 *
 * Element rendered:
 * - `href` (and not disabled)  -> `<a>`
 * - `href` + `disabled`        -> `<span aria-disabled>` (non-navigable)
 * - no `href`                  -> `<button type=...>`
 *
 * Content is slotted, so an icon + label compose naturally (the button is a
 * flex row). Visual variants are `primary` (filled) and `secondary` (outline).
 * Set `arrow` to append the standard trailing forward arrow (e.g. card CTAs) or
 * `back` to prepend the leading back arrow (e.g. a detail page's "All projects");
 * fill the `icon` slot to prepend an `<Icon>` (e.g. a Slides/Video glyph).
 *
 * @component
 * @slot default - Button label / icon content.
 * @slot icon - Optional leading icon, rendered before the label.
 *
 * @example
 * ```astro
 * <Button href="/projects" variant="primary">View My Work</Button>
 * <Button href="https://cal.com/x" variant="secondary" external>Book a call</Button>
 * <Button href="/projects/x" variant="secondary" arrow>View case study</Button>
 * <Button href="https://slides.example" variant="secondary" external>
 *   <Icon slot="icon" name="slides" />Slides
 * </Button>
 * <Button variant="secondary" disabled aria-label="Previous page">…</Button>
 * ```
 */

import Icon from '@components/Icon.astro';
import type { HTMLAttributes } from 'astro/types';

/**
 * Any other valid attribute (aria-label, id, title, data-*, ...) is forwarded to
 * the rendered element. `<a>` is the base set; `href` and `type` are redeclared
 * below because this component gives them narrower meanings.
 */
interface Props extends Omit<HTMLAttributes<'a'>, 'href' | 'type'> {
  /** Destination. Provided -> renders a link; omitted -> renders a <button>. */
  href?: string;
  /** Visual style. */
  variant?: 'primary' | 'secondary';
  /** Open link in a new tab. */
  external?: boolean;
  /** Disabled state (non-interactive). */
  disabled?: boolean;
  /** Append the standard trailing forward arrow after the label. */
  arrow?: boolean;
  /** Prepend the standard leading back arrow before the label. */
  back?: boolean;
  /** Button type when rendered as <button>. */
  type?: 'button' | 'submit' | 'reset';
}

const {
  href,
  variant,
  external = false,
  disabled = false,
  arrow = false,
  back = false,
  type = 'button',
  ...rest
} = Astro.props;

const Tag = !href ? 'button' : disabled ? 'span' : 'a';

const tagAttrs =
  Tag === 'a'
    ? { href, ...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {}) }
    : Tag === 'button'
      ? { type, disabled }
      : { 'aria-disabled': true };
---

<Tag
  class:list={[
    'btn',
    { [`btn--${variant}`]: variant },
    { 'btn--disabled': disabled },
  ]}
  {...tagAttrs}
  {...rest}
>
  <span>
    {back && <Icon name="arrow-left" />}
    <slot name="icon" />
    <slot />
    {arrow && <Icon name="arrow-right" />}
  </span>
</Tag>

<style>
  .btn {
    font-family: inherit;
    line-height: inherit;
    cursor: pointer;
    color: currentColor;
    background: transparent;
    display: inline-flex;

    span {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
    }
  }

  .btn:where([class*="btn--"]) {
    border: 1px solid;
    text-decoration: none;
    font-weight: bolder;
    font-size: 0.7em;
    letter-spacing: 2px;

    span {
      padding: 12px 24px;
    }
  }

  /* Filled: the surface and the ink swap. Both are real colours (see
     `--dash-ink` / `--dash-ground` in global.css); `currentColor` cannot do
     this on its own, because the label inherits it too. */
  .btn--primary {
    background-color: var(--dash-ink);
    border-color: var(--dash-ink);

    span {
      color: var(--dash-ground);
    }
  }

  .btn--disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }
</style>
