---
/**
 * Card Component
 *
 * The single, slot-driven card used across the site (projects, decisions,
 * articles, talks, and the journey timeline's content area). It has no
 * per-type variants: differences are expressed purely through which slots a
 * call site fills.
 *
 * Given an `href` the whole card is clickable. The anchor wraps the `title`
 * slot alone and its `::after` is stretched over the card, so the accessible
 * name is the title rather than the card's every heading, tag, and paragraph
 * read out in one link. A linked card therefore needs a `title` slot; anything
 * else interactive inside it stays clickable, because it is lifted above the
 * overlay.
 *
 * The meta / title / description wrappers are only rendered when their slot is
 * filled, so the card also works as a styled shell (passing bespoke markup in
 * the default slot).
 *
 * @component
 *
 * @slot badge - Optional badge/label row at top (e.g. status, type)
 * @slot meta - Metadata line (date, role, category, etc.)
 * @slot title - Card heading/title, and the link text when `href` is set
 * @slot description - Card description or summary text
 * @slot tags - Container for a TagList
 * @slot default - Bespoke content below the tags (e.g. a talk's slides/video
 *   links, or a timeline disclosure)
 *
 * @example
 * ```astro
 * <Card href="/projects/gridless">
 *   <Fragment slot="meta">January 2024</Fragment>
 *   <Fragment slot="title">Card Title</Fragment>
 *   <Fragment slot="description">Card description text</Fragment>
 * </Card>
 * ```
 */

interface Props {
  /**
   * Anchor target for the card, so a listing can offer a table of contents that
   * jumps to it. This is the one attribute the card accepts: it identifies the
   * card, it does not style it (see the no-`class` rule in CLAUDE.md). It sits
   * on the `<article>` rather than the title so the jump lands at the top of the
   * card, and so it still works on a card with no `title` slot.
   */
  id?: string;

  /** Destination. Provided -> the whole card is clickable (needs a `title`). */
  href?: string;

  /** Open the card's link in a new tab. */
  external?: boolean;
}

const { id, href, external = false } = Astro.props;

const hasMeta = Astro.slots.has('meta');
const hasTitle = Astro.slots.has('title');
const hasDescription = Astro.slots.has('description');

const linkAttrs = external ? { target: '_blank', rel: 'noopener noreferrer' } : {};
---

<article class:list={['card', { 'card--link': href }]} id={id}>
  <slot name="badge" />
  {hasMeta && <span><slot name="meta" /></span>}
  {hasTitle && (
    <h3>
      {href ? <a href={href} {...linkAttrs}><slot name="title" /></a> : <slot name="title" />}
    </h3>
  )}
  {hasDescription && <p><slot name="description" /></p>}
  <slot name="tags" />
  <slot />
</article>

<style>
  /* No background of its own: the card sits directly on `main`'s surface and is
     drawn by its rule alone, so the shell's texture runs through the listing
     rather than being interrupted by a box per entry. */
  .card {
    display: flex;
    flex-direction: column;
    align-items: start;
    margin-block: var(--grid-padding);


    & > span {
      font-size: .8em;
      padding-block-end: 8px;
      opacity: .7;
    }

    & > h3 {
      margin: 0;
      font-size: 2em;
      line-height: 1;

      & > a {
        color: inherit;
        text-decoration: none;

        /* The stretched hit area: the whole card, from the title's own link. */
        &::after {
          content: '';
          position: absolute;
          inset: 0;
        }

        &:hover,
        &:focus-visible {
          text-decoration: underline;
          text-decoration-color: var(--accent-color);
        }
      }
    }
  }

  /* Only a linked card positions itself, so the overlay has something to fill. */
  .card--link {
    position: relative;
    cursor: pointer;

    /* Anything else interactive sits above the overlay and stays clickable. */
    & :where(a, button, details, summary):not(h3 > a) {
      position: relative;
    }
  }
</style>
