---
/**
 * Nav
 *
 * The dashboard's masthead: the wordmark (home link) plus the main navigation,
 * driven by `siteConfig.nav`. The current page is marked with `aria-current`,
 * matching on path prefix so detail pages (e.g. /projects/foo) highlight their
 * section.
 *
 * @component
 */

import { siteConfig } from '@/config';
import Logo from '@assets/logo.svg';

const currentPath = Astro.url.pathname;

/**
 * Home is active only on the exact root; every other item is active when the
 * current path sits underneath it.
 */
const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<style>
    .nav {
        padding: var(--grid-padding);
        display: flex;
        flex-wrap: wrap;
        gap: 16px;
        justify-content: space-between;
        align-items: center;
        background: var(--dash-bg);
        background-attachment: fixed;
        color: var(--dash-fg);

        & > a {
            padding: 16px;
            line-height: 1;
            text-decoration: none;
            background: black;
            color: red;
        }

        svg {
            width: 1em;
        }
    }

    ul {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-wrap: wrap;
        gap: 16px;
    }

    a[aria-current="page"] {
        font-weight: bolder;
    }
</style>

<header class="nav">
    <a href="/" aria-current={isActive('/') ? 'page' : undefined}>
        <Logo/>
    </a>
    <nav aria-label="Main navigation">
        <ul>
            {siteConfig.nav.map((item) => (
                <li>
                    <a
                        href={item.href}
                        aria-current={isActive(item.href) ? 'page' : undefined}
                    >{item.label}</a>
                </li>
            ))}
        </ul>
    </nav>
</header>
