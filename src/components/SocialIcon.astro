---
/**
 * SocialIcon Component
 *
 * Inline brand glyphs for the configured social platforms, so the Contact bar
 * can show icons instead of platform names. Paths are the `-line` (outlined)
 * variants from Remix Icon (https://remixicon.com), the same source as
 * ArrowIcon, inlined rather than pulled from an icon font so nothing extra
 * ships or blocks paint.
 *
 * The glyph is decorative: it is `aria-hidden`, and the call site is
 * responsible for naming its link (Contact does this with `aria-label`).
 *
 * @component
 *
 * @example
 * ```astro
 * <SocialIcon name="github" />
 * <SocialIcon name="bluesky" size={24} />
 * ```
 */

/** Platform keys this component can draw, matching `siteConfig.social`. */
export type SocialIconName = 'linkedin' | 'bluesky' | 'github' | 'mastodon';

interface Props {
  /** Which platform glyph to render */
  name: SocialIconName;
  /** Width/height of the rendered SVG in px (default: 20) */
  size?: number;
}

const { name, size = 20 } = Astro.props;

/** Remix Icon `-line` path data, keyed by platform. */
