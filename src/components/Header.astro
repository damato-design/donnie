---
/**
 * Header
 *
 * The dashboard's header bar: a `space-between` flex row carrying a list of
 * links at one end and a single standalone action at the other. `Layout` renders
 * two of them, the masthead and the connect bar, which are the same bar with
 * their halves swapped.
 *
 * This replaced `Nav.astro` and `Contact.astro`, which carried byte-identical
 * layout CSS and the same markup in opposite orders.
 *
 * **It knows nothing about which bar it is.** It imports no config: which list
 * a bar carries and which grid area it occupies are decided where it is
 * rendered. A `HeaderLink` is deliberately the same shape as a `siteConfig.nav`
 * or `siteConfig.social` entry, so those lists are handed straight in with no
 * mapping.
 *
 * @component
 *
 * @example
 * ```astro
 * <Header
 *   name="nav"
 *   label="Main navigation"
 *   action={{ href: '/', label: siteConfig.title, logo: true }}
 *   links={siteConfig.nav}
 * />
 * ```
 */

import Icon, { type IconName } from '@components/Icon.astro';
import Logo from '@assets/logo.svg';

/** One link in a header bar. */
export interface HeaderLink {
  /** Destination. A site path, or an absolute URL for an external link. */
  href: string;
  /**
   * Link text. When `icon` or `logo` draws the label instead, this becomes the
   * link's accessible name (`aria-label`) and its tooltip, so a link is never
   * left unnamed. The wordmark used to be exactly that: an unlabelled link.
   */
  label: string;
  /** Draw this glyph in place of the label. */
  icon?: IconName;
  /** Draw the wordmark in place of the label. */
  logo?: boolean;
}

interface Props {
  /**
   * Which shell panel this bar is. It is the class `global.css` assigns a
   * `grid-area` to, next to the template that names it.
   */
  name: 'nav' | 'contact';

  /** Accessible name for the `<nav>` wrapping the list. */
  label: string;

  /**
   * The links, rendered as a list. `readonly`, so a list can be handed straight
   * from `siteConfig` (which is `as const`) without being copied to satisfy the
   * type. An entry with a blank `href` is skipped.
   */
  links: readonly HeaderLink[];

  /**
   * The standalone link at the other end of the row.
   *
   * Its position is not configurable: a `logo` action leads, because a bar whose
   * action is the wordmark is a masthead, and every other action follows the
   * list.
   */
  action: HeaderLink;

  /**
   * The listed links are the author's own profiles elsewhere, so each gets
   * `rel="me"`.
   *
   * **This is load-bearing, not decorative.** `rel="me"` is the IndieWeb
   * identity assertion: it claims the destination is another profile of the
   * same person as this page. Mastodon's verified checkmark reads it, following
   * the link back from the site listed in a profile's fields, so removing it
   * quietly un-verifies the account.
   *
   * It is a property of the bar rather than of each link, since it is true of
   * every link in such a list and of none anywhere else, which is also what
   * lets `siteConfig.social` be handed over with no mapping.
   *
   * Unlike the rest of this component's behaviour it cannot be derived: nothing
   * about a URL says whose profile it is (the site links to `mode.place` and
   * `wireframe.ds.house` too, and those are not `rel="me"`), and this component
   * reads no config, so it has to be asserted at the call site.
   */
  profiles?: boolean;
}

const { name, label, links, action, profiles = false } = Astro.props;

/**
 * Whether a link points at the page being rendered.
 *
 * `Astro.url` is right here in the render scope, so this is resolved where
 * `aria-current` is written rather than threaded in as a prop. Home matches the
 * exact root only; every other item matches on prefix, so a detail page
 * (`/projects/foo`) still highlights its section. An external link is never
 * current, which is what keeps this off the social profiles and the booking
 * link.
 */
const currentPath = Astro.url.pathname;
const isExternal = (link: HeaderLink) => /^https?:\/\//.test(link.href);
const isCurrent = (link: HeaderLink) =>
  !isExternal(link) &&
  (link.href === '/' ? currentPath === '/' : currentPath.startsWith(link.href));

/**
 * The row's two halves, in DOM order. Ordering them here rather than with CSS
 * `order` keeps reading and tab order matching what is on screen.
 *
 * The wordmark leads: an action that draws the logo is a masthead's, and a
 * masthead opens with it. Anything else follows the list.
 */
const parts = action.logo ? (['action', 'list'] as const) : (['list', 'action'] as const);

/** Attributes every link in the bar shares, whatever it draws. */
const attrs = (link: HeaderLink, me = false) => ({
  href: link.href,
  target: isExternal(link) ? '_blank' : undefined,
  // `me` marks the author's own profile; a new tab still needs `noopener`.
  rel:
    [me && 'me', isExternal(link) && 'noopener noreferrer'].filter(Boolean).join(' ') || undefined,
  'aria-current': isCurrent(link) ? ('page' as const) : undefined,
  // A link whose label is drawn rather than written needs it as an a11y name.
  ...(link.icon || link.logo ? { 'aria-label': link.label, title: link.label } : {}),
});
---

<header class:list={['header', name, 'dash-surface']}>
  {parts.map((part) =>
    part === 'action' ? (
      <a {...attrs(action)} class="btn">
        {action.logo ? <Logo /> : action.icon ? <Icon name={action.icon} /> : action.label}
      </a>
    ) : (
      <nav aria-label={label}>
        <ul>
          {links.filter((link) => link.href).map((link) => (
            <li>
              <a class:list={[(link.icon || link.logo) && 'btn']} {...attrs(link, profiles)}>
                {link.logo ? (
                  <Logo />
                ) : link.icon ? (
                  <Icon name={link.icon} size="1.25rem" />
                ) : (
                  link.label
                )}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )
  )}
</header>

<style>
  /* Placement and the dark surface come from global.css (`.dash-surface` and
     the `body > .nav` / `body > .contact` rules); only the bar's own layout
     lives here. */
  .header {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    justify-content: space-between;
    align-items: center;

    a {
      text-decoration: none;
    }

    svg {
      width: 1em;
    }
  }

  .btn {
    padding: 16px;
    line-height: 1;
    text-decoration: none;
    background: var(--dark-color);
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;

    li {
      display: flex;
    }

    /** Slashes between the navigation items */
    &:not(:has(.btn)) {
      gap: var(--grid-padding);

      /* Twice the column gap, so a wrapped row has room for the current-page
         bar to sit in the space beneath the row above it rather than landing
         on the top edge of the row below. */
      row-gap: calc(var(--grid-padding) * 2);

      li:last-child {
        margin-inline-end: var(--grid-padding);
      }
    }
  }

  a:is([aria-current='page'], [href*="cal.com"]) {
    color: var(--accent-color);
  }

  /* The masthead's links fill their row rather than sitting centred in it, so
     that a link's bottom edge *is* the bottom of the row it is on. That is what
     the bar below hangs off, and it is what keeps the bar with its word when
     the list wraps. The logo keeps the header's own `align-items: center`;
     only the list stretches. */
  .nav nav {
    display: flex;
    align-self: stretch;
  }

  .nav ul {
    align-items: stretch;
  }

  .nav li a {
    display: flex;
    align-items: center;
    position: relative;
  }

  /* The current-page bar
     ------------------------------------------------------------------------
     One bar, under the current page, which follows the pointer or the keyboard
     while the list is being explored and returns to the current page when it is
     let go.

     It is a single box pointed at a link by CSS anchor positioning, so moving it
     is a matter of moving the *name*: the current item holds `--nav-current` at
     rest and hands it to whichever sibling is hovered or focused. Nothing is
     drawn per link and nothing is duplicated.

     Because it is one box throughout, the move animates: the insets the anchor
     resolves to are interpolated like any other length, so a plain `transition`
     on the pseudo-element is the whole of the slide. That is the argument for a
     single box over a bar per link, which could only ever hand off between two
     separate elements.

     The `transition` asks nothing about `prefers-reduced-motion`, and shouldn't:
     `--vt-duration` is itself 0s under that preference (see the motion policy in
     global.css), so this slide is off with the rest of the shell's motion
     without restating the query here.

     It hangs off the bottom edge of the link, which the rule above stretches to
     fill its row, plus the header's own content inset. On one row that lands it
     flush with the bottom of the `<header>`, in the 2px seam between the
     masthead and the panels below: a length of that gap lighting up under the
     current word, rather than an underline hung off the text. Reading the block
     edge off the anchor rather than pinning it to the header (`bottom: 0`) is
     what keeps the bar with its word when the list wraps.

     Masthead only. The connect bar's links are external, so none of them is ever
     current and there is no resting place for the bar to return to. */

  /* The bar without anchor positioning: drawn on the current link itself, where
     it cannot follow anything, so Firefox still gets the part that matters. The
     `@supports` block below takes it over wherever the real one can be drawn. */
  .nav a[aria-current='page']::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    margin-top: var(--grid-padding);
    height: var(--grid-gap);
    background: var(--accent-color);
    pointer-events: none;
  }

  @supports (anchor-name: --nav-current) {
    .nav a[aria-current='page']::after {
      content: none;
    }

    .nav {
      position: relative;
      /* Keep the name inside the masthead, so nothing outside can claim it. */
      anchor-scope: --nav-current;
    }

    /* At rest the bar is anchored to the current page. */
    .nav a[aria-current='page'] {
      anchor-name: --nav-current;
    }

    /* While the list is being explored it is anchored to the hovered or focused
       link instead. The `:not()` is what keeps these two rules from fighting
       when the current item is itself the hovered one: the name simply stays
       where it is, so neither the order they are written in nor their
       specificity matters. */
    .nav ul:has(a:is(:hover, :focus-visible)) a[aria-current='page']:not(:hover, :focus-visible) {
      anchor-name: none;
    }

    .nav ul a:is(:hover, :focus-visible) {
      anchor-name: --nav-current;
    }

    /* `:has()` gates the whole pseudo-element: with no current item and nothing
       hovered (the 404 page), `--nav-current` names nothing, and an unresolved
       anchor would leave the bar somewhere arbitrary rather than nowhere. */
    .nav:has(a:is([aria-current='page'], :hover, :focus-visible))::after {
      content: '';
      position: absolute;
      position-anchor: --nav-current;
      /* Stretched between the anchor's own edges, so the bar is exactly as wide
         as the word it belongs to, and no taller than the shell's own seams. */
      left: anchor(left);
      right: anchor(right);
      top: anchor(bottom);
      /* The header's own content inset, so the bar clears the row and lands on
         the panel's bottom edge. It is half the list's row gap, which is what
         centres it in the space between two wrapped rows. */
      margin-top: var(--grid-padding);
      height: var(--grid-gap);
      background: var(--accent-color);
      /* The three insets above are all that ever change, and all of them are
         lengths, so the shorthand's implicit `all` has exactly them to work on
         and the bar slides to its new anchor. */
      transition: var(--vt-duration) var(--vt-ease);
    }
  }
</style>
