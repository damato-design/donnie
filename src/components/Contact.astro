---
/**
 * Contact
 *
 * The dashboard's connect bar: the configured social profiles plus the primary
 * "schedule a chat" action. This replaces the former /contact page, so it is
 * rendered on every page by the layout rather than being a destination of its
 * own.
 *
 * Each profile shows its brand glyph (`SocialIcon`) rather than the platform's
 * name, so the link's accessible name comes from `aria-label` instead of its
 * text content.
 *
 * Only non-empty entries in `siteConfig.social` are rendered, so hiding a
 * platform is a matter of blanking it in config.
 *
 * @component
 */

import { siteConfig } from '@/config';
import SocialIcon, { type SocialIconName } from '@components/SocialIcon.astro';

/** Accessible names for the config's social keys. */
const socialLabels: Record<SocialIconName, string> = {
  linkedin: 'LinkedIn',
  bluesky: 'Bluesky',
  github: 'GitHub',
  mastodon: 'Mastodon',
};

const socials = (Object.entries(siteConfig.social) as [SocialIconName, string][])
  .filter(([, url]) => Boolean(url))
  .map(([key, url]) => ({ name: key, label: socialLabels[key], url }));
---

<style>
    .contact {
        padding: var(--grid-padding);
        display: flex;
        flex-wrap: wrap;
        gap: 16px;
        justify-content: space-between;
        align-items: center;
        background: var(--dash-bg);
        background-attachment: fixed;
        color: var(--dash-fg);

        & > a {
            padding: 16px;
            line-height: 1;
            text-decoration: none;
            background: black;
            color: red;
        }
    }

    ul {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 16px;

        & a {
            display: inline-flex;
            padding: 12px;
            line-height: 0;
            color: inherit;
            background: black;
            color: red;
        }
    }
</style>

<header class="contact">
    <ul>
        {socials.map((social) => (
            <li>
                <a
                    href={social.url}
                    target="_blank"
                    rel="me noopener noreferrer"
                    aria-label={social.label}
                    title={social.label}
                >
                    <SocialIcon name={social.name} />
                </a>
            </li>
        ))}
    </ul>
    <a href={siteConfig.scheduling} target="_blank" rel="noopener noreferrer">Schedule a chat</a>
</header>
