---
/**
 * Square
 *
 * The dashboard's media panel: a 1:1 box holding the page's media. This is
 * where the old `Hero`'s `aside` content now lives (a portrait, a sizzle reel,
 * an embedded web component, ...).
 *
 * The media fills the box edge to edge, which is why this is the one panel
 * `global.css` does not inset. With an empty slot the panel is a bare
 * `.grid-surface`, which is what the detail pages leave behind them.
 *
 * @component
 *
 * @slot default - The page's media (an <img>, <video>, or embed).
 */

interface Props {}
---

<style>
    /* Captured as a single unit across navigations. The motion this name drives
       lives in global.css under "View transition choreography"; the panel's
       gradient comes from `.grid-surface` there. */
    .square {
        view-transition-name: square;
        aspect-ratio: 1;
        width: 100%;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
        /* The blend group for `Media`'s `mix-blend-mode: overlay`: isolating
           here makes the panel's own gradient the backdrop the photo blends
           onto, which is what produces the red duotone. */
        isolation: isolate;

        & > * {
            min-width: 0;
            max-width: 100%;
            max-height: 100%;
        }

        /* `:global` because <Image> renders its <img> outside this scope. */
        & :global(:where(img, video)) {
            max-width: 100%;
            max-height: 100%;
        }
    }

    @media (max-width: 800px) {
        .square {
            display: none;
        }
    }
</style>

<section class="square grid-surface">
    <slot/>
</section>
