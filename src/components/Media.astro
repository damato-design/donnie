---
/**
 * Media
 *
 * Renders the right element for a given `src`: an image, a video, or audio.
 * This keeps call sites declarative, they pass a `src` and an `alt`/label and
 * don't have to know which element a particular file needs.
 *
 * `src` accepts either form:
 *
 * - An **imported local asset** (`ImageMetadata`, from `import img from
 *   '@assets/x.png'`) renders through `astro:assets` `<Image>`, so it is
 *   optimized at build time: modern formats, a generated `srcset`, and intrinsic
 *   `width`/`height` so the panel doesn't shift as it loads.
 * - A **plain string** path or URL (a `/`-rooted public asset, a remote file)
 *   renders as-is. Remote files can't be optimized at build time, and video and
 *   audio are never processed, so those always take this path.
 *
 * The file extension selects the element for string sources; an imported asset
 * is always an image.
 *
 * Video and audio default to showing native `controls`; pass `controls={false}`
 * to opt out. Any other valid attribute (loading, width, height, autoplay,
 * loop, muted, poster, ...) is forwarded to the rendered element.
 *
 * **Images load eagerly, at high priority.** Every call site puts its media in
 * `Square`, which is above the fold on every page, so this image is the page's
 * Largest Contentful Paint element. `<Image>`'s default `loading="lazy"` makes
 * the browser discover it only after layout and fetch it at low priority, which
 * is exactly the LCP delay Lighthouse flags. Both are plain attributes rather
 * than `<Image>`'s `priority` shorthand, so a call site can still override
 * either one through `...rest`.
 *
 * Sizing belongs to the panel, not to this component: every call site drops its
 * media into `Square`, which is a fixed 1:1 box that centers and clips whatever
 * it is given. The `grayscale` + `overlay` pair below is what turns the photo
 * into the site's red duotone against `Square`'s gradient (and what
 * `src/lib/duotone.ts` reproduces with sharp for the OG cards, since satori can
 * do neither).
 *
 * @component
 *
 * @example
 * ```astro
 * import cover from '@assets/cover.png';
 *
 * <Media src={cover} alt="Book cover" />
 * <Media src="/media/talk.mp4" alt="Conference talk" poster="/media/talk.jpg" />
 * <Media src="/media/episode.mp3" alt="Podcast episode" />
 * <Media src="https://example.com/sizzle.webm" alt="Sizzle reel" controls={false} autoplay loop muted />
 * ```
 */

import { Image } from 'astro:assets';
import type { HTMLAttributes } from 'astro/types';

/**
 * Attributes forwarded to whichever element is rendered. `<video>` carries the
 * widest set, so it is the base; `crossorigin`, `width`, and `height` are
 * redeclared or dropped because `<Image>` types them more narrowly than
 * `<video>` does and one type has to satisfy every branch.
 */
interface Props
  extends Omit<HTMLAttributes<'video'>, 'src' | 'controls' | 'crossorigin' | 'width' | 'height'> {
  /** Explicit width. Imported assets carry their own, so this is rarely needed. */
  width?: number | `${number}`;
  /** Explicit height. Imported assets carry their own, so this is rarely needed. */
  height?: number | `${number}`;
  /** An imported local image, or a path/URL. The extension selects the element. */
  src: ImageMetadata | string;
  /** Text alternative (img `alt`) / accessible label (aria-label for a/v). */
  alt?: string;
  /** Show native controls on video/audio (default: true; ignored for images). */
  controls?: boolean;
}

const { src, alt = '', controls = true, ...rest } = Astro.props;

const VIDEO = ['mp4', 'webm', 'ogv', 'mov', 'm4v'];
const AUDIO = ['mp3', 'wav', 'ogg', 'oga', 'm4a', 'aac', 'flac'];

/** An imported asset is always an image; a string is classified by extension. */
const ext = typeof src === 'string' ? (src.split(/[?#]/)[0].split('.').pop()?.toLowerCase() ?? '') : '';
const kind =
  typeof src !== 'string' ? 'asset' : VIDEO.includes(ext) ? 'video' : AUDIO.includes(ext) ? 'audio' : 'image';

/** The element for a string source. `asset` goes through `<Image>` instead. */
const Tag = kind === 'image' ? 'img' : kind;
---

{
  kind === 'asset' ? (
    <Image
      class="media"
      src={src as ImageMetadata}
      alt={alt}
      loading="eager"
      fetchpriority="high"
      {...rest}
    />
  ) : kind === 'image' ? (
    <img
      class="media"
      src={src as string}
      alt={alt}
      loading="eager"
      fetchpriority="high"
      {...rest}
    />
  ) : (
    <Tag class="media" src={src as string} controls={controls} aria-label={alt || undefined} {...rest} />
  )
}

<style>
  /* These stay scoped: Astro forwards this component's scope attribute onto
     `<Image>`'s rendered <img>, so all four branches are covered. */
  .media {
    display: block;
    max-width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .media, :global(mode-book) {
    mix-blend-mode: overlay;
    filter: grayscale(1);
  }

  /* A photo fills the panel's width; a video keeps its own, capped above. */
  img.media {
    width: 100%;
  }
</style>
