---
/**
 * Media
 *
 * Renders the right element for a given `src`: an image, a video, audio, or an
 * embed. Call sites pass whatever a page's `media` frontmatter carries and an
 * `alt`/label, and don't have to know, or say, which element it needs. There is
 * one `media` key in frontmatter for exactly this reason: what a value needs is
 * something the value itself says.
 *
 * `src` accepts three forms:
 *
 * - An **imported local asset** (`ImageMetadata`, which is what a schema's
 *   `image()` resolves a relative path into) renders through `astro:assets`
 *   `<Image>`, so it is optimized at build time: modern formats, a generated
 *   `srcset`, and intrinsic `width`/`height` so the panel doesn't shift as it
 *   loads.
 * - A **plain string** path or URL (a `/`-rooted public asset, a remote file)
 *   renders as-is, with the file extension selecting the element. Remote files
 *   can't be optimized at build time, and video and audio are never processed,
 *   so those always take this path.
 * - An **embed name** from `EMBEDS` (`content.config.ts`) renders that custom
 *   element and loads the module that defines it. This is the one medium that
 *   is markup rather than a file, which is why frontmatter can only name it.
 *
 * **A video here is wallpaper, not a player.** Every call site drops its media
 * into `Square`, where a video is decorative and captionless, so video defaults
 * to autoplaying muted on a loop with no controls. Audio still shows controls.
 * Both are plain attributes, so a call site can override any of them.
 *
 * **Images load eagerly, at high priority.** Every call site puts its media in
 * `Square`, which is above the fold on every page, so this image is the page's
 * Largest Contentful Paint element. `<Image>`'s default `loading="lazy"` makes
 * the browser discover it only after layout and fetch it at low priority, which
 * is exactly the LCP delay Lighthouse flags. Both are plain attributes rather
 * than `<Image>`'s `priority` shorthand, so a call site can still override
 * either one through `...rest`.
 *
 * Sizing belongs to the panel, not to this component: `Square` is a fixed 1:1
 * box that centers and clips whatever it is given. The `grayscale` + `overlay`
 * pair below is what turns the photo into the site's red duotone against
 * `Square`'s gradient (and what `src/lib/duotone.ts` reproduces with sharp for
 * the OG cards, since satori can do neither).
 *
 * @component
 *
 * @example
 * ```astro
 * import cover from '@assets/cover.png';
 *
 * <Media src={cover} alt="Book cover" />
 * <Media src="/media/talk.mp4" alt="Conference talk" poster="/media/talk.jpg" />
 * <Media src="/media/episode.mp3" alt="Podcast episode" />
 * <Media src="https://example.com/sizzle.webm" alt="Sizzle reel" />
 * <Media src="mode-book" alt="Mise en Mode, the book" />
 * ```
 */

import { Image } from 'astro:assets';
import type { HTMLAttributes } from 'astro/types';
import { EMBEDS } from '@/content.config';

/**
 * Attributes forwarded to whichever element is rendered. `<video>` carries the
 * widest set, so it is the base; `crossorigin`, `width`, and `height` are
 * redeclared or dropped because `<Image>` types them more narrowly than
 * `<video>` does and one type has to satisfy every branch.
 */
interface Props
  extends Omit<HTMLAttributes<'video'>, 'src' | 'crossorigin' | 'width' | 'height'> {
  /** Explicit width. Imported assets carry their own, so this is rarely needed. */
  width?: number | `${number}`;
  /** Explicit height. Imported assets carry their own, so this is rarely needed. */
  height?: number | `${number}`;
  /** An imported local image, a path/URL, or an embed name. */
  src: ImageMetadata | string;
  /** Text alternative (img `alt`) / accessible label (aria-label for a/v). */
  alt?: string;
}

const { src, alt = '', ...rest } = Astro.props;

const VIDEO = ['mp4', 'webm', 'ogv', 'mov', 'm4v'];
const AUDIO = ['mp3', 'wav', 'ogg', 'oga', 'm4a', 'aac', 'flac'];

/**
 * What the value is. An imported asset is always an image; a string is an embed
 * when it names one and is classified by extension otherwise.
 */
const embed = typeof src === 'string' && src in EMBEDS ? (src as keyof typeof EMBEDS) : undefined;
const ext = typeof src === 'string' ? (src.split(/[?#]/)[0].split('.').pop()?.toLowerCase() ?? '') : '';
const kind = embed
  ? 'embed'
  : typeof src !== 'string'
    ? 'asset'
    : VIDEO.includes(ext)
      ? 'video'
      : AUDIO.includes(ext)
        ? 'audio'
        : 'image';

/**
 * The custom element the embed names. Astro renders a capitalized variable
 * holding a tag name as that tag, which is how a value in frontmatter ends up
 * as an element here.
 */
const Embed = embed as string;
---

{
  kind === 'embed' ? (
    <Fragment>
      <Embed />
      <script is:inline type="module" src={EMBEDS[embed as keyof typeof EMBEDS]} />
    </Fragment>
  ) : kind === 'asset' ? (
    <Image
      class="media"
      src={src as ImageMetadata}
      alt={alt}
      loading="eager"
      fetchpriority="high"
      {...rest}
    />
  ) : kind === 'image' ? (
    <img
      class="media"
      src={src as string}
      alt={alt}
      loading="eager"
      fetchpriority="high"
      {...rest}
    />
  ) : kind === 'video' ? (
    <video
      class="media"
      src={src as string}
      aria-label={alt || undefined}
      autoplay
      loop
      muted
      playsinline
      {...rest}
    />
  ) : (
    <audio class="media" src={src as string} aria-label={alt || undefined} controls {...rest} />
  )
}

<style>
  /* These stay scoped: Astro forwards this component's scope attribute onto
     `<Image>`'s rendered <img>, so all four branches are covered. */
  .media {
    display: block;
    max-width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* The embed is a custom element, so it is styled globally rather than by the
     class the other branches carry. */
  .media, :global(mode-book) {
    mix-blend-mode: overlay;
    filter: grayscale(1);
  }

  /* A photo fills the panel's width; a video keeps its own, capped above. */
  img.media {
    width: 100%;
  }
</style>
